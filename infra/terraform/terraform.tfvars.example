# คัดลอกเป็น terraform.tfvars แล้วใส่ค่าจริง (ไฟล์นี้อยู่ใน .gitignore แล้ว)

project     = "pier2pier"
environment = "dev"
aws_region  = "us-east-1"

# Multi-AZ: standby ใน AZ-b ใช้สำหรับ failover เท่านั้น รับ query ไม่ได้
# EC2 ทั้งสองเครื่องต่อผ่าน endpoint เดียวกัน ตอน failover RDS สลับ DNS ให้เอง
# ค่า RDS คูณสอง — ถ้าต้องการประหยัดช่วงพัฒนาให้ตั้ง false ชั่วคราว
db_multi_az = true

db_password = "เปลี่ยนเป็นรหัสผ่านที่คาดเดายากไม่เกิน41ตัวอักษร"
jwt_secret  = "สร้างด้วย openssl rand -base64 48"

# ต้อง push API image ไป ECR ด้วยแท็กนี้ก่อน apply ส่วน EC2
image_tag = "latest"

# Learner Lab ที่ SCP ปฏิเสธ s3:GetBucketObjectLockConfiguration:
# สร้าง bucket pier2pier-dev-web ด้วย AWS CLI ก่อน apply และลบเองหลัง destroy
# manage_frontend_bucket = false

alarm_email = "your-email@example.com"
