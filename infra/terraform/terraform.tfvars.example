# คัดลอกเป็น terraform.tfvars แล้วใส่ค่าจริง (ไฟล์นี้อยู่ใน .gitignore แล้ว)

project     = "pier2pier"
environment = "dev"
aws_region  = "us-east-1"

# Multi-AZ: standby ใน AZ-b ใช้สำหรับ failover เท่านั้น รับ query ไม่ได้
# EC2 ทั้งสองเครื่องต่อผ่าน endpoint เดียวกัน ตอน failover RDS สลับ DNS ให้เอง
# ค่า RDS คูณสอง — ถ้าต้องการประหยัดช่วงพัฒนาให้ตั้ง false ชั่วคราว
db_multi_az = true

db_password = "เปลี่ยนเป็นรหัสผ่านที่คาดเดายาก"
jwt_secret  = "สร้างด้วย openssl rand -base64 48"

alarm_email = "your-email@example.com"
